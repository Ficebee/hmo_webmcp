# HMO.InnerVoice WebMCP Challenge — Environment Configuration
# Copy this file to .env and set appropriate values for local development.
# NEVER commit .env with real secrets.

# Application Mode
PUBLIC_DEMO_MODE=true
NODE_ENV=development

# WebMCP Configuration
WEBMCP_PORT=3000
WEBMCP_HOST=localhost

# API Configuration
API_BASE_URL=http://localhost:3000

# Data Source
DATA_SOURCE=demo
DATA_PATH=./data/entities.json

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=*

# Note: This is a challenge demonstrator using public data only.
# No production credentials, API keys, or sensitive data should be added here.
